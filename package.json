{
  "name": "@richardmcquiston01/social-platforms",
  "version": "0.0.0",
  "description": "Post your own images to your own Facebook Page, Instagram, Threads and Pinterest from TypeScript: OAuth logins with token refresh, thin API clients and one publisher interface. Functions return Results instead of throwing; the core is runtime-neutral, with a ./node subpath for the local OAuth redirect listener.",
  "keywords": [
    "social",
    "facebook",
    "instagram",
    "threads",
    "pinterest",
    "oauth",
    "publishing",
    "graph-api",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "Richard McQuiston (https://richardmcquiston.com/)",
  "homepage": "https://github.com/RichardMcQuiston01/social-platforms#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/social-platforms.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/social-platforms/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "meta": [
        "./dist/meta.d.cts"
      ],
      "threads": [
        "./dist/threads.d.cts"
      ],
      "pinterest": [
        "./dist/pinterest.d.cts"
      ],
      "s3": [
        "./dist/s3.d.cts"
      ],
      "node": [
        "./dist/node.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./meta": {
      "import": {
        "types": "./dist/meta.d.ts",
        "default": "./dist/meta.js"
      },
      "require": {
        "types": "./dist/meta.d.cts",
        "default": "./dist/meta.cjs"
      }
    },
    "./threads": {
      "import": {
        "types": "./dist/threads.d.ts",
        "default": "./dist/threads.js"
      },
      "require": {
        "types": "./dist/threads.d.cts",
        "default": "./dist/threads.cjs"
      }
    },
    "./pinterest": {
      "import": {
        "types": "./dist/pinterest.d.ts",
        "default": "./dist/pinterest.js"
      },
      "require": {
        "types": "./dist/pinterest.d.cts",
        "default": "./dist/pinterest.cjs"
      }
    },
    "./s3": {
      "import": {
        "types": "./dist/s3.d.ts",
        "default": "./dist/s3.js"
      },
      "require": {
        "types": "./dist/s3.d.cts",
        "default": "./dist/s3.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.3",
    "bun": ">=1.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
